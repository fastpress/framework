{
    "name": "fastpress/framework",
    "description": "A lightweight PHP micro-framework for building web applications with MVC, dependency injection, and middleware.",
    "type": "library",
    "require": {
        "php": "^8.0",
        "fastpress/request": "^0.2",
        "fastpress/response": "^0.2",
        "fastpress/router": "^0.2",
        "fastpress/session": "^0.2",
        "fastpress/view": "^0.2",
        "fastpress/database": "^0.2"
    },
    "scripts": {
        "test": "phpunit",
        "fix-style": "phpcbf --standard=PSR12 src/",
        "lint": "phpcs --standard=PSR12 src/",
        "analyze": "phpstan analyse src/"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Fastpress\\": "src/"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "samayo",
            "email": "samayo@pm.me"
        }
    ],
    "keywords": [
        "framework",
        "fastpress",
        "mvc",
        "micro-framework",
        "php"
    ],
    "homepage": "https://github.com/fastpress/framework",
    "support": {
        "issues": "https://github.com/fastpress/framework/issues",
        "source": "https://github.com/fastpress/framework"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.0"
        }
    }
}
